# Copy to .env and adjust. Every value is optional — these are the defaults.

PORT=3001
DATABASE_PATH=data/ots.db

# --- Business model -------------------------------------------------------
CURRENCY=USD
# Platform cut of every ticket, in basis points (500 = 5%).
COMMISSION_BPS=500
# What a host pays to put an activity on the map.
LISTING_FEE_STANDARD_CENTS=100
LISTING_FEE_FEATURED_CENTS=200

# --- Demo mode ------------------------------------------------------------
# Payments and ID checks are simulated. Sample activities are created on first run.
DEMO_MODE=true
# Where the map opens and where sample activities are placed.
MAP_CENTER_LAT=40.7359
MAP_CENTER_LNG=-73.9911
MAP_ZOOM=13
# Comma-separated e-mails allowed to see /admin.
ADMIN_EMAILS=demo@ots.app

# --- Map ------------------------------------------------------------------
TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Address search when hosting. Leave empty to turn it off.
GEOCODER_URL=https://nominatim.openstreetmap.org

# --- Deployment -----------------------------------------------------------
# Set to 1 when running behind a reverse proxy (Render, Fly, nginx ...).
TRUST_PROXY=
